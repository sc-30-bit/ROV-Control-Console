  <property name="styleSheet">
   <string notr="true">/*
 * ===================================================================
 * Sci-Fi ROV Control Deck Theme
 * Author: AI Assistant
 * ===================================================================
*/

/* ---- 主窗口背景 ---- */
QWidget#Widget {
    background-color: #0a192f; /* 深海军蓝，作为基础色 */
}

/* ---- 通用标签样式 ---- */
QLabel {
    color: #ccd6f6; /* 浅蓝灰色，用于普通文本 */
    background-color: transparent;
    font-family: &quot;Ubuntu&quot;, sans-serif; /* 使用您UI中已有的字体 */
    font-weight: bold;
}

/* ---- 关键信息标签（如&quot;已连接&quot;, 温度, 水深） ---- */
QLabel#label, QLabel#label_3, QLabel#label_4, QLabel#label_Z1, QLabel#label_Z2 {
    color: #64ffda; /* 明亮的薄荷绿/青色，用于高亮关键数据 */
    font-size: 13pt;
    font-weight: bold;
}

/* ---- 视频/图像占位符标签 ---- */
QLabel#label_2, QLabel#label_5, QLabel#stitching, QLabel#rov, QLabel#hit_jpg, QLabel#rover_jpg {
    background-color: rgba(10, 25, 47, 0.8); /* 半透明深蓝背景 */
    border: 1px solid #173A5E; /* 暗蓝色边框 */
    border-radius: 8px;
    color: #527299; /* 低对比度文字 */
    font-size: 25pt;
    font-weight: bold;
    qproperty-alignment: 'AlignCenter';
}

/* ---- 输入框和文本浏览器 (QLineEdit, QTextEdit, QTextBrowser) ---- */
QLineEdit, QTextEdit, QTextBrowser {
    color: #e6f1ff; /* 亮白色文本 */
    background-color: rgba(42, 60, 86, 0.7); /* 半透明蓝灰色背景 */
    border: 1px solid #173A5E; /* 暗蓝色边框 */
    border-radius: 5px;
    padding: 8px;
    font-size: 10pt;
    font-weight: bold;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #64ffda; /* 聚焦时边框高亮 */
    background-color: rgba(42, 60, 86, 1);
}

QLineEdit:read-only {
    background-color: rgba(42, 60, 86, 0.4); /* 只读字段背景更暗 */
}

/* ---- 按钮 (QPushButton) ---- */
QPushButton {
    color: #64ffda;
    background-color: transparent;
    border: 1px solid #64ffda;
    border-radius: 4px;
    padding: 10px;
    font-size: 12pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: rgba(100, 255, 218, 0.1); /* 悬停时有青色光晕 */
}

QPushButton:pressed {
    background-color: rgba(100, 255, 218, 0.2); /* 按下时光晕更强 */
}

/* ---- 图标工具按钮 (QToolButton) ---- */
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 25px; /* 使悬停效果为圆形 */
}

QToolButton:hover {
    /* 径向渐变模拟一个中心向外的光晕效果 */
    background-color: qradialgradient(cx:0.5, cy:0.5, radius: 0.8, fx:0.5, fy:0.5, 
                                      stop:0 rgba(100, 255, 218, 0.3), 
                                      stop:1 transparent);
}

/* ---- 分组框 (QGroupBox) ---- */
QGroupBox {
    background-color: rgba(23, 58, 94, 0.3); /* 半透明背景，区分面板 */
    border: 1px solid #173A5E;
    border-radius: 8px;
    margin-top: 24px; /* 为标题留出空间 */
    font-size: 11pt;
    font-weight: bold;
}

QGroupBox::title {
    color: #ccd6f6;
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 5px 10px;
    background-color: #112240;
    border: 1px solid #173A5E;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

/* ---- Tab选项卡控件 (QTabWidget) ---- */
QTabWidget::pane {
    border: 1px solid #173A5E;
    border-radius: 5px;
    background-color: #0a192f;
}

QTabBar::tab {
    color: #8892b0; /* 未选中标签页的颜色 */
    background-color: #112240; /* 未选中标签页的背景 */
    border: 1px solid #173A5E;
    border-bottom: none;
    padding: 10px 25px;
    font-size: 10pt;
    font-weight: bold;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:hover {
    color: #64ffda;
    background-color: #173A5E;
}

QTabBar::tab:selected {
    color: #0a192f; /* 选中标签页的文字颜色 */
    background-color: #64ffda; /* 选中标签页的背景颜色 */
    border: 1px solid #64ffda;
    border-bottom: none;
}

/* ---- 数字调节框 (QDoubleSpinBox) ---- */
QDoubleSpinBox {
    color: #e6f1ff;
    background-color: rgba(42, 60, 86, 0.7);
    border: 1px solid #173A5E;
    border-radius: 5px;
    padding: 5px;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    border: none;
    background-color: #527299;
    width: 20px;
}

QDoubleSpinBox::up-arrow, QDoubleSpinBox::down-arrow {
    image: none; /* 如果有默认箭头，可以隐藏掉，或者替换成自己的图标 */
}

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #64ffda;
}

/* ---- LCD数字时钟 ---- */
LcdDateTime {
    color: #64ffda;
    background-color: transparent;
    border: none;
}
</string>
